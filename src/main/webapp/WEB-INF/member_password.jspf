<%@ page import="java.nio.charset.StandardCharsets,java.security.GeneralSecurityException,java.security.MessageDigest,java.security.SecureRandom,java.util.Base64,javax.crypto.SecretKeyFactory,javax.crypto.spec.PBEKeySpec" %>
<%!
    private static final String PASSWORD_PREFIX = "pbkdf2-sha256$";
    private static final int PASSWORD_ITERATIONS = 600000;
    private static final SecureRandom PASSWORD_RANDOM = new SecureRandom();

    private byte[] derivePassword(String password, byte[] salt) throws GeneralSecurityException {
        PBEKeySpec spec = new PBEKeySpec(password.toCharArray(), salt, PASSWORD_ITERATIONS, 256);
        try {
            return SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(spec).getEncoded();
        } finally {
            spec.clearPassword();
        }
    }

    private String hashPassword(String password) throws GeneralSecurityException {
        byte[] salt = new byte[16];
        PASSWORD_RANDOM.nextBytes(salt);
        Base64.Encoder encoder = Base64.getEncoder();
        return PASSWORD_PREFIX + encoder.encodeToString(salt) + "$"
                + encoder.encodeToString(derivePassword(password, salt));
    }

    private boolean verifyPassword(String password, String stored) throws GeneralSecurityException {
        if (password == null || password.length() > 1024 || stored == null) return false;
        if (!stored.startsWith(PASSWORD_PREFIX)) {
            return MessageDigest.isEqual(stored.getBytes(StandardCharsets.UTF_8),
                                         password.getBytes(StandardCharsets.UTF_8));
        }
        String[] parts = stored.substring(PASSWORD_PREFIX.length()).split("\\$", -1);
        if (parts.length != 2) return false;
        try {
            Base64.Decoder decoder = Base64.getDecoder();
            byte[] salt = decoder.decode(parts[0]);
            byte[] expected = decoder.decode(parts[1]);
            return salt.length == 16 && expected.length == 32
                    && MessageDigest.isEqual(expected, derivePassword(password, salt));
        } catch (IllegalArgumentException e) {
            return false;
        }
    }
%>
