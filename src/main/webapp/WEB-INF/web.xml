<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Database maintenance pages</web-resource-name>
            <url-pattern>/auto_import_products.jsp</url-pattern>
            <url-pattern>/clear_user_reviews.jsp</url-pattern>
            <url-pattern>/init_sample_data.jsp</url-pattern>
            <url-pattern>/update_images.jsp</url-pattern>
            <url-pattern>/update_to_reference_data.jsp</url-pattern>
            <url-pattern>/db_status.jsp</url-pattern>
            <url-pattern>/dbConnection.jsp</url-pattern>
            <url-pattern>/test_db.jsp</url-pattern>
            <url-pattern>/page_template.jsp</url-pattern>
            <url-pattern>/page_meta.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
